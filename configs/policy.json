{
  "version": "policy-v1",
  "agents": {
    "coder-agent": {
      "workload_ids": ["coder-agent", "coder-workload-v1"],
      "capabilities": {
        "generate_code": {
          "allowed_tools": ["coder"],
          "required_scopes": ["code.read"],
          "resources": {
            "public_workspace": {
              "allowed_operations": ["generate"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": [],
                "max_bytes": 1048576,
                "max_duration_ms": 30000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": [],
            "executor_profile": "standard-route"
          }
        },
        "read_safe_files": {
          "allowed_tools": ["filesystem"],
          "required_scopes": ["code.read"],
          "resources": {
            "public_workspace": {
              "allowed_operations": ["read"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": [],
                "max_bytes": 1048576,
                "max_duration_ms": 30000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": []
          }
        },
        "read_config": {
          "allowed_tools": ["config_reader"],
          "required_scopes": ["config.read"],
          "route": "sandbox",
          "resources": {
            "protected_config": {
              "allowed_operations": ["read"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": [],
                "max_bytes": 262144,
                "max_duration_ms": 15000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": [],
            "executor_profile": "sandbox-route"
          }
        },
        "run_limited_commands": {
          "allowed_tools": ["shell.exec"],
          "required_scopes": ["code.read"],
          "route": "restrict",
          "resources": {
            "public_workspace": {
              "allowed_operations": ["execute"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "allow",
                "allowed_side_effects": ["process_execution"],
                "max_duration_ms": 5000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "allow",
            "allowed_side_effects": ["process_execution"],
            "executor_profile": "restricted-route"
          }
        }
      }
    },
    "finance-agent": {
      "workload_ids": ["finance-agent", "finance-workload-v1"],
      "capabilities": {
        "read_finance_data": {
          "allowed_tools": ["finance_reader"],
          "required_scopes": ["finance.read"],
          "resources": {
            "finance_data": {
              "allowed_operations": ["read"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": [],
                "max_bytes": 524288,
                "max_duration_ms": 15000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": []
          }
        },
        "summarize_reports": {
          "allowed_tools": ["report_reader"],
          "required_scopes": ["finance.read"],
          "resources": {
            "finance_data": {
              "allowed_operations": ["summarize"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": []
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": []
          }
        },
        "payment_transfer": {
          "allowed_tools": ["payment.send"],
          "required_scopes": ["payment.transfer"],
          "resources": {
            "account-123": {
              "allowed_operations": ["transfer"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "allow",
                "allowed_side_effects": ["financial_transaction"],
                "max_duration_ms": 10000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "allow",
            "allowed_side_effects": ["financial_transaction"],
            "executor_profile": "external-executor"
          }
        }
      }
    },
    "ops-agent": {
      "workload_ids": ["ops-agent", "ops-workload-v1"],
      "capabilities": {
        "read_config": {
          "allowed_tools": ["config_reader"],
          "required_scopes": ["config.read"],
          "route": "sandbox",
          "resources": {
            "protected_config": {
              "allowed_operations": ["read"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": [],
                "max_bytes": 262144
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": []
          }
        },
        "write_config": {
          "allowed_tools": ["config_writer"],
          "required_scopes": ["config.write"],
          "route": "restrict",
          "resources": {
            "protected_config": {
              "allowed_operations": ["write"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "allow",
                "allowed_side_effects": ["configuration_change"],
                "max_bytes": 65536
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "allow",
            "allowed_side_effects": ["configuration_change"],
            "executor_profile": "restricted-route"
          }
        },
        "run_limited_commands": {
          "allowed_tools": ["shell.exec"],
          "required_scopes": ["config.write"],
          "route": "restrict",
          "resources": {
            "protected_config": {
              "allowed_operations": ["execute"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "allow",
                "allowed_side_effects": ["process_execution"],
                "max_duration_ms": 5000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "allow",
            "allowed_side_effects": ["process_execution"],
            "executor_profile": "restricted-route"
          }
        }
      }
    },
    "integration-agent": {
      "workload_ids": ["integration-agent", "integration-workload-v1"],
      "capabilities": {
        "read_config": {
          "allowed_tools": ["config_reader"],
          "required_scopes": ["config.read"],
          "route": "sandbox",
          "resources": {
            "protected_config": {
              "allowed_operations": ["read"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": [],
                "max_bytes": 262144
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": []
          }
        },
        "external_request": {
          "allowed_tools": ["http.post"],
          "required_scopes": ["network.access"],
          "route": "restrict",
          "resources": {
            "external_network": {
              "allowed_operations": ["send"],
              "constraints": {
                "network_egress": "allow",
                "secret_access": "deny",
                "write_access": "deny",
                "allowed_side_effects": ["external_egress"],
                "max_bytes": 65536,
                "max_duration_ms": 5000
              }
            }
          },
          "constraints": {
            "network_egress": "allow",
            "secret_access": "deny",
            "write_access": "deny",
            "allowed_side_effects": ["external_egress"],
            "executor_profile": "restricted-route"
          }
        },
        "run_limited_commands": {
          "allowed_tools": ["shell.exec"],
          "required_scopes": ["code.read"],
          "route": "restrict",
          "resources": {
            "public_workspace": {
              "allowed_operations": ["execute"],
              "constraints": {
                "network_egress": "deny",
                "secret_access": "deny",
                "write_access": "allow",
                "allowed_side_effects": ["process_execution"],
                "max_duration_ms": 5000
              }
            }
          },
          "constraints": {
            "network_egress": "deny",
            "secret_access": "deny",
            "write_access": "allow",
            "allowed_side_effects": ["process_execution"],
            "executor_profile": "restricted-route"
          }
        }
      }
    }
  },
  "resources": {
    "public_workspace": {"sensitivity": "low", "required_scopes": ["code.read"]},
    "protected_config": {"sensitivity": "high", "required_scopes": ["config.read"]},
    "finance_data": {"sensitivity": "critical", "required_scopes": ["finance.read"]},
    "secrets_store": {"sensitivity": "critical", "required_scopes": ["secrets.read"]},
    "external_network": {"sensitivity": "medium", "required_scopes": ["network.access"]},
    "account-123": {"sensitivity": "critical", "required_scopes": ["payment.transfer"]}
  },
  "sensitive_actions": ["read_config", "write_config", "read_finance_data", "read_secret", "invoke_admin_tool"],
  "restricted_actions": ["write_config", "external_request"],
  "prohibited_actions": ["disable_audit", "exfiltrate_data"],
  "suspicious_runtime_actions": ["read_secret", "invoke_admin_tool", "disable_audit", "exfiltrate_data"],
  "session_controls": {
    "privacy_read_budget": 3,
    "cumulative_risk_limit": 80,
    "egress_capabilities": ["external_request", "send_data", "upload_file", "exfiltrate_data"],
    "side_effect_capabilities": ["write_config", "run_limited_commands", "external_request", "invoke_admin_tool"],
    "injection_risk_signals": ["instruction_like_content", "tool_directive", "policy_override", "credential_request"]
  },
  "compatibility": {
    "allow_legacy_flat_requests": true,
    "allow_missing_tool": true,
    "allow_missing_operation": true
  },
  "permits": {
    "ttl_seconds": 30,
    "issuer": "aegis-router"
  },
  "semantic_actions": {
    "payment_send_v1": {
      "profile_id": "payment.send/v1",
      "mcp_tool": "payment.send",
      "capability": "payment_transfer",
      "resource": "account-123",
      "operation": "transfer",
      "audience": "mcp://local-payment-sandbox",
      "upstream_url": "http://127.0.0.1:3001/mcp",
      "allowed_currencies": ["CNY", "USD"],
      "max_amount_minor_by_currency": {
        "CNY": 50000,
        "USD": 10000
      },
      "allowed_recipients": ["merchant-456", "merchant-demo"]
    }
  }
}
